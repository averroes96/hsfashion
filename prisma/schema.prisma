// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Catalog {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]
}

model Family {
  id          String   @id @default(uuid())
  name        String
  arabicName  String?
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]
}

model Product {
  id          String   @id @default(uuid())
  familyId    String
  reference   String   @unique
  details     String?
  description String?
  sizeAssortment   Json?
  badge            String?
  isActive         Boolean        @default(true)
  views            Int            @default(0)
  aiSimilarCache   Json?
  aiCacheUpdatedAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  family           Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  catalogs         Catalog[]
  images           ProductImage[]
  orderItems       OrderItem[]
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  originalUrl  String
  thumbnailUrl String
  mediumUrl    String
  fullUrl      String
  isPrimary    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model StoreSettings {
  id           String   @id @default("default")
  phoneNumber  String?
  email        String?
  address      String?
  promoMessage String?
  updatedAt    DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  VALIDATED
  PROCESSING
  COMPLETED
  CANCELLED
}

model Order {
  id            String       @id @default(uuid())
  orderNumber   String       @unique
  customerPhone String
  customerName  String?
  customerCity  String?
  notes         String?
  status        OrderStatus  @default(PENDING)
  totalCartons  Int          @default(0)
  items         OrderItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String?
  reference   String
  cartons     Int      @default(1)
  familyTitle String?
  imageUrl    String?

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}
